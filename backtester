import yfinance as yf
import pandas as pd
import numpy as np
from concurrent.futures import ThreadPoolExecutor, as_completed

# S&P 500 및 나스닥 100 핵심 섹터별 대규모 확장 유니버스 (~70+ 종목)
MASSIVE_UNIVERSE = [
    # 빅테크 & 반도체 & 소프트웨어
    "AAPL", "MSFT", "NVDA", "GOOGL", "AMZN", "META", "TSLA", "AMD", "INTC", "IBM", 
    "ORCL", "QCOM", "AVGO", "TXN", "ADBE", "CRM", "NFLX", "CSCO", "ACN", "INTU",
    # 금융 & 투자은행 & 결제
    "JPM", "BAC", "WFC", "C", "GS", "MS", "BLK", "AXP", "V", "MA", "PYPL",
    # 헬스케어 & 제약 & 바이오테크
    "JNJ", "UNH", "PFE", "MRK", "ABBV", "TMO", "DHR", "LLY", "AMGN", "GILD",
    # 에너지 & 정유
    "XOM", "CVX", "COP", "SLB", "EOG", "OXY", "PSX", "VLO", "MPC",
    # 경기소비재 & 필수소비재 & 유통
    "WMT", "PG", "KO", "PEP", "MCD", "DIS", "HD", "LOW", "NKE", "COST",
    # 통신 & 유틸리티 & 산업재
    "T", "VZ", "NEE", "DUK", "SO", "BA", "CAT", "DE", "HON", "UPS", "FDX"
]

def calculate_indicators(df):
    close = df['Close']
    delta = close.diff()
    gain = (delta.where(delta > 0, 0)).rolling(14).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(14).mean()
    rs = gain / loss
    df['RSI'] = 100 - (100 / (1 + rs))
    df['SMA_200'] = close.rolling(200).mean()
    return df

def run_single_backtest(ticker, start_date="2010-01-01", tp_pct=0.40, sl_pct=0.20):
    try:
        df = yf.download(ticker, start=start_date, interval="1d", progress=False)
        if df.empty or len(df) < 200:
            return []
        
        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.get_level_values(0)

        df = calculate_indicators(df)
        trades = []
        in_position = False
        entry_price = 0.0
        stop_loss_price = 0.0
        take_profit_price = 0.0

        close = df['Close']
        rsi = df['RSI']
        sma200 = df['SMA_200']

        for i in range(200, len(close)):
            p = float(close.iloc[i])
            r = float(rsi.iloc[i])
            s200 = float(sma200.iloc[i])
            dt = df.index[i]
            year = dt.year

            if not in_position:
                # 대세 상승장(200일선 위) + 과매도(RSI < 38) 진입 조건
                if p > s200 and r < 38:
                    in_position = True
                    entry_price = p
                    stop_loss_price = p * (1.0 - sl_pct)      # -20% 손절
                    take_profit_price = p * (1.0 + tp_pct)  # +40% 익절
            else:
                if p >= take_profit_price:
                    trades.append({"ticker": ticker, "year": year, "return": tp_pct * 100, "win": True})
                    in_position = False
                elif p <= stop_loss_price:
                    trades.append({"ticker": ticker, "year": year, "return": -sl_pct * 100, "win": False})
                    in_position = False
                elif i == len(close) - 1:
                    ret = (p - entry_price) / entry_price
                    trades.append({"ticker": ticker, "year": year, "return": ret * 100, "win": ret > 0})
                    in_position = False

        return trades
    except Exception as e:
        return []

if __name__ == "__main__":
    print("="*80)
    print(" 🚀 MASSIVE SCALE MULTI-THREADED QUANT BACKTESTER")
    print(f" ⚙️ 유니버스 규모: {len(MASSIVE_UNIVERSE)}개 핵심 대형주 | 익절 +40% / 손절 -20%")
    print("="*80)

    all_trades = []
    
    # 병렬 처리(ThreadPoolExecutor)를 통한 고속 다운로드 및 백테스트 구동
    print("[*] 멀티스레드로 전체 유니버스 데이터를 고속 수집 및 백테스트 실행 중...")
    with ThreadPoolExecutor(max_workers=8) as executor:
        futures = {executor.submit(run_single_backtest, ticker): ticker for ticker in MASSIVE_UNIVERSE}
        for future in as_completed(futures):
            res = future.result()
            if res:
                all_trades.extend(res)

    if not all_trades:
        print("[!] 실행된 거래가 없습니다.")
    else:
        df_all = pd.DataFrame(all_trades)
        
        print("\n" + "="*80)
        print(" 📊 대규모 확장 유니버스 연도별 통합 성과 리포트 (2010~2026)")
        print("="*80)
        print(f"{'연도':<6} | {'총 거래수':<8} | {'승률 (%)':<10} | {'총수익률 합계 (%)':<18} | {'평균 수익률/건':<15}")
        print("-" * 80)

        for yr, group in sorted(df_all.groupby('year')):
            t_count = len(group)
            w_count = len(group[group['win']])
            w_rate = (w_count / t_count) * 100 if t_count > 0 else 0
            sum_ret = group['return'].sum()
            avg_ret = group['return'].mean()
            print(f" • {yr}년  | {t_count:<8} | {w_rate:<10.2f} | {sum_ret:>+15.2f}%    | {avg_ret:>+12.2f}%")
        print("="*80)
        
        print(f"\n[*] [전체 매시브 유니버스 통합 성과 요약]")
        print(f" • 총 누적 거래 수 : {len(df_all)}건")
        print(f" • 전체 평균 승률  : {(len(df_all[df_all['win']])/len(df_all))*100:.2f}%")
        print(f" • 전체 누적 수익 합계: {df_all['return'].sum():+.2f}%")
        print("="*80)
