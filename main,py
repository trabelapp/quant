def precompute_market():
    np.random.seed(42)
    news_pool = [
        ("Institutional Block Trade Detected: Heavy Accumulation", "POSITIVE"),
        ("Derivatives Desk Reports Implied Volatility Expansion", "NEUTRAL"),
        ("Quantitative Rebalancing Flow Expected at Close", "POSITIVE"),
        ("Sector Rotation Index Signals Outflows from Peers", "NEGATIVE"),
        ("Smart Money Net Exposure Adjusted Upwards by 4.2%", "POSITIVE")
    ]

    for t in SP500_UNIVERSE:
        h = abs(hash(t))
        base_price = 20.0 + (h % 600)
        returns = np.random.normal(0.001, 0.025, len(SHARED_DATES))
        prices = base_price * np.cumprod(1 + returns)
        
        chart = [
            {
                "time": DATE_STRS[i],
                "open": round(float(prices[i] - (prices[i]*0.004)), 2),
                "high": round(float(prices[i] + (prices[i]*0.008)), 2),
