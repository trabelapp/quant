            for i in range(len(SHARED_DATES))
        ]
        cp = chart[-1]["close"]
        pp = chart[-2]["close"]
        chg = round(((cp - pp) / pp) * 100, 2)
        score = round(60.0 + (h % 38) + np.random.uniform(0, 1.9), 2)
        vol = round(np.std(returns) * np.sqrt(252), 3)
        
        t_news = [
            {"time": "10:42", "headline": news_pool[h % len(news_pool)][0], "impact": news_pool[h % len(news_pool)][1]},
            {"time": "09:15", "headline": f"Dark Pool Volume Surge Observed for {t}", "impact": "POSITIVE"},
            {"time": "Yesterday", "headline": f"Goldman Sachs Quant Desk Updates Model Weight for {t}", "impact": "NEUTRAL"}
        ]

        GLOBAL_MARKET_CACHE[t] = {
            "ticker": t,
            "price": cp,
