            function drawCandleChart(chartData, levels) {
                const canvas = document.getElementById('main-canvas');
                const container = document.getElementById('main-canvas-container');
                const ctx = canvas.getContext('2d');

                const dpr = window.devicePixelRatio || 1;
                canvas.width = container.clientWidth * dpr;
                canvas.height = container.clientHeight * dpr;
                ctx.scale(dpr, dpr);

                const width = container.clientWidth;
                const height = container.clientHeight;

                ctx.clearRect(0, 0, width, height);
                if (!chartData || chartData.length === 0) return;

                const paddingLeft = 10;
                const paddingRight = 75; // 가격 축 여백
                const paddingTop = 20;
                const paddingBottom = 30;

                const chartWidth = width - paddingLeft - paddingRight;
                const chartHeight = height - paddingTop - paddingBottom;

                let minPrice = Infinity;
                let maxPrice = -Infinity;
                chartData.forEach(d => {
                    if (d.low < minPrice) minPrice = d.low;
                    if (d.high > maxPrice) maxPrice = d.high;
                });

                if (levels) {
                    if (levels.tp > maxPrice) maxPrice = levels.tp;
                    if (levels.sl < minPrice) minPrice = levels.sl;
                }

                const priceRange = maxPrice - minPrice || 1;
                minPrice -= priceRange * 0.03;
                maxPrice += priceRange * 0.03;
                const adjRange = maxPrice - minPrice;

                const getX = (i) => paddingLeft + (i / (chartData.length - 1 || 1)) * chartWidth;
                const getY = (p) => paddingTop + chartHeight - ((p - minPrice) / adjRange) * chartHeight;

                // 격자 및 가격 축 라인
                ctx.strokeStyle = '#141414';
                ctx.lineWidth = 1;
                for (let i = 0; i <= 5; i++) {
                    const y = paddingTop + (chartHeight / 5) * i;
                    ctx.beginPath();
                    ctx.moveTo(paddingLeft, y);
                    ctx.lineTo(width - paddingRight, y);
                    ctx.stroke();

                    const pVal = maxPrice - (adjRange / 5) * i;
                    ctx.fillStyle = '#6b7280';
                    ctx.font = '9px Courier New';
                    ctx.textAlign = 'left';
                    ctx.fillText('$' + pVal.toFixed(2), width - paddingRight + 6, y + 3);
                }

                // 타겟 가격선 (TP, Entry, SL) 드로잉
                if (levels) {
                    const drawLevelLine = (val, color, label, isDotted) => {
                        const y = getY(val);
                        ctx.strokeStyle = color;
                        ctx.lineWidth = label === 'Entry' ? 1.5 : 1;
                        if (isDotted) ctx.setLineDash([3, 3]);
                        else ctx.setLineDash([]);
                        
                        ctx.beginPath();
                        ctx.moveTo(paddingLeft, y);
                        ctx.lineTo(width - paddingRight, y);
                        ctx.stroke();
                        ctx.setLineDash([]);

                        // 우측 태그 박스
                        ctx.fillStyle = color;
                        ctx.fillRect(width - paddingRight, y - 8, paddingRight, 16);
                        ctx.fillStyle = '#000000';
                        ctx.font = 'bold 9px Courier New';
                        ctx.textAlign = 'left';
                        ctx.fillText(`${label}: $${val.toFixed(2)}`, width - paddingRight + 4, y + 3);
                    };
                    drawLevelLine(levels.tp, '#f59e0b', 'TP', true);
                    drawLevelLine(levels.entry, '#10b981', 'Entry', false);
                    drawLevelLine(levels.sl, '#ef4444', 'SL', true);
                }

                // 캔들 바 너비 계산
                const candleWidth = Math.max(2, (chartWidth / chartData.length) * 0.65);

                chartData.forEach((d, i) => {
                    const x = getX(i);
                    const yOpen = getY(d.open);
                    const yClose = getY(d.close);
                    const yHigh = getY(d.high);
                    const yLow = getY(d.low);

                    const isGreen = d.close >= d.open;
                    const color = isGreen ? '#10b981' : '#ef4444';

                    // 심지 (Wick)
                    ctx.strokeStyle = color;
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.moveTo(x, yHigh);
                    ctx.lineTo(x, yLow);
                    ctx.stroke();

                    // 몸통 (Body)
                    ctx.fillStyle = color;
                    const bodyY = Math.min(yOpen, yClose);
                    const bodyH = Math.max(1, Math.abs(yClose - yOpen));
                    ctx.fillRect(x - candleWidth / 2, bodyY, candleWidth, bodyH);
                });

                // 하단 날짜 라벨
                ctx.fillStyle = '#6b7280';
                ctx.font = '9px Courier New';
                ctx.textAlign = 'left';
                ctx.fillText(chartData[0].time, paddingLeft, height - 10);
                ctx.textAlign = 'center';
                ctx.fillText(chartData[Math.floor(chartData.length / 2)].time, paddingLeft + chartWidth / 2, height - 10);
                ctx.textAlign = 'right';
                ctx.fillText(chartData[chartData.length - 1].time, width - paddingRight, height - 10);
            }

            function drawMiniLineChart(canvasId, lineData, lineColor) {
                const canvas = document.getElementById(canvasId);
                const ctx = canvas.getContext('2d');
                const dpr = window.devicePixelRatio || 1;
                canvas.width = canvas.clientWidth * dpr;
                canvas.height = 45 * dpr;
                ctx.scale(dpr, dpr);

                const width = canvas.clientWidth;
                const height = 45;

                ctx.clearRect(0, 0, width, height);
                if (!lineData || lineData.length === 0) return;

                let minVal = Infinity, maxVal = -Infinity;
                lineData.forEach(d => {
                    if (d.value < minVal) minVal = d.value;
                    if (d.value > maxVal) maxVal = d.value;
                });
                const range = maxVal - minVal || 1;

                const getX = (i) => (i / (lineData.length - 1 || 1)) * width;
                const getY = (v) => height - 6 - ((v - minVal) / range) * (height - 12);

                ctx.strokeStyle = lineColor;
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                lineData.forEach((d, i) => {
                    const x = getX(i);
                    const y = getY(d.value);
                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                });
                ctx.stroke();
            }

            function runScan() {
                const ticker = document.getElementById('ticker-input').value.toUpperCase();
                if (ticker) fetchData(ticker);
            }

            async function fetchData(selectedTicker = null) {
                const ticker = selectedTicker || document.getElementById('ticker-input').value.toUpperCase();
                const mode = document.getElementById('mode-select').value;
                document.getElementById('ticker-input').value = ticker;

                try {
                    const response = await fetch(`/api/terminal-data?ticker=${ticker}&mode=${encodeURIComponent(mode)}`);
                    const data = await response.json();
                    
                    const cur = data.current;
                    document.getElementById('header-ticker').innerText = cur.ticker;
                    document.getElementById('header-price').innerText = '$' + cur.price.toFixed(2);
                    document.getElementById('metric-entry').innerText = '$' + cur.entry.toFixed(2);
                    document.getElementById('metric-tp').innerText = '$' + cur.tp.toFixed(2);
                    document.getElementById('metric-sl').innerText = '$' + cur.sl.toFixed(2);
                    document.getElementById('ai-report-box').innerHTML = cur.ai_report;

                    // 뉴스 피드 렌더링
                    let newsHTML = '';
                    if (cur.news && cur.news.length > 0) {
                        cur.news.forEach(n => {
                            const impactColor = n.impact === 'POSITIVE' ? '#10b981' : (n.impact === 'NEGATIVE' ? '#ef4444' : '#f59e0b');
                            newsHTML += `
                                <div class="news-item">
                                    <span class="news-time">[${n.time}]</span>
                                    <span style="color: ${impactColor};">■</span> ${n.headline}
                                </div>
                            `;
                        });
                    } else {
                        newsHTML = '<div class="news-item" style="color:#6b7280;">No recent institutional catalysts.</div>';
                    }
                    document.getElementById('news-container').innerHTML = newsHTML;

                    // 캔들 차트 및 레벨 캐싱 후 드로잉
                    currentChartData = cur.chart;
                    currentLevels = { tp: cur.tp, entry: cur.entry, sl: cur.sl };
                    drawCandleChart(currentChartData, currentLevels);

                    // 벤치마크 지수 미니 차트 드로잉
                    drawMiniLineChart('sp-canvas', data.indices.sp.chart, '#10b981');
                    document.getElementById('sp-meta').innerText = data.indices.sp.price.toLocaleString() + ` (+${data.indices.sp.change}%)`;

                    drawMiniLineChart('ix-canvas', data.indices.ix.chart, '#3b82f6');
                    document.getElementById('ix-meta').innerText = data.indices.ix.price.toLocaleString() + ` (+${data.indices.ix.change}%)`;

                    renderMatrixAndFeed(data.matrix);

                } catch (err) {
                    console.error("Sync error:", err);
                }
            }

            function renderMatrixAndFeed(matrix) {
                const tbody = document.getElementById('matrix-tbody');
                const feedContainer = document.getElementById('alpha-feed-container');
                
                let tbodyHTML = '';
                let feedHTML = '';

                matrix.forEach((item, index) => {
                    const chgClass = item.change >= 0 ? 'positive' : 'negative';
                    const chgSign = item.change >= 0 ? '+' : '';

                    tbodyHTML += `
                        <tr onclick="fetchData('${item.ticker}')">
                            <td><b>${item.ticker}</b></td>
                            <td>$${item.price.toFixed(2)}</td>
                            <td class="${chgClass}">${chgSign}${item.change.toFixed(2)}%</td>
                            <td style="text-align: right;" class="positive"><b>${item.alpha_score.toFixed(2)}</b></td>
                        </tr>
                    `;

                    if (index < 5) {
                        feedHTML += `
                            <div class="slot-row" onclick="fetchData('${item.ticker}')">
                                <span><b>${item.ticker}</b><br><span style="font-size:9px; color:#6b7280;">$${item.price.toFixed(2)}</span></span>
                                <span style="text-align: right;"><span class="${chgClass}">${chgSign}${item.change.toFixed(2)}%</span><br><span style="font-size:9px; color:#6b7280;">Score: ${item.alpha_score.toFixed(2)}</span></span>
                            </div>
                        `;
                    }
                });

                tbody.innerHTML = tbodyHTML;
                feedContainer.innerHTML = feedHTML;
            }

            window.onresize = () => {
                if (currentChartData) {
                    drawCandleChart(currentChartData, currentLevels);
                }
            };

            window.onload = () => {
                fetchData('AAPL');
            };
        </script>
    </body>
    </html>
    """

